{
  "name": "@playbill/core",
  "version": "0.1.0",
  "private": true,
  "description": "Configurable skill pipelines rendered for coding agents",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
    "playbill": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pi": {
      "types": "./dist/pi.d.ts",
      "import": "./dist/pi.js"
    },
    "./opencode": {
      "types": "./dist/opencode.d.ts",
      "import": "./dist/opencode.js"
    }
  },
  "files": [
    "dist",
    "docs/formats.md",
    "adapters",
    ".claude-plugin",
    ".codex-plugin",
    "skills",
    "defaults",
    "docs/adapters"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "check-all": "npm run format:check && npm run lint && npm run type-check",
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "playbill": "node dist/cli.js"
  },
  "dependencies": {
    "smol-toml": "1.8.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@eslint/js": "10.0.1",
    "@opencode-ai/plugin": "1.18.29",
    "@types/node": "24.13.3",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@opencode-ai/plugin": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./adapters/pi/playbill.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
